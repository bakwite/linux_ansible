server {
    listen 80;
    server_name www.zrlog.com;

    root /code/zrlog/ROOT;
    index index.jsp;

    location ~* \.(css|js|jpg|jpeg|png|gif|ico|svg|woff|woff2|ttf)$ {
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        include proxy_params;
    }
}
