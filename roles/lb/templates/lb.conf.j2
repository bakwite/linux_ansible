{# 生成每个站点的 upstream 和 server 配置 #}
{% for site in sites %}
upstream {{ site.upstream }} {
{% for server in site.servers | default(web_backend_hosts) %}
    server {{ server }}:80;
{% endfor %}
    keepalive 16;
}

server {
    listen 443 ssl;
    server_name {{ site.server_name }};          #  每个站点自己的域名
    ssl_certificate   {{ ssl_cert_path }}/{{ site.ssl_cert }};
    ssl_certificate_key  {{ ssl_cert_path }}/{{ site.ssl_key }};

    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1440m;
    ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:ECDHE:ECDH:AES:HIGH:!NULL:!aNULL:!MD5:!ADH:!RC4;
    ssl_protocols TLSv1 TLSv1.1 TLSv1.2;
    ssl_prefer_server_ciphers on;

    location / {
        proxy_pass http://{{ site.upstream }};
        include proxy_params;
    }
}
{% endfor %}

# HTTP 重定向（合并所有域名）
server {
    listen 80;
    server_name {% for site in sites %}{{ site.server_name }} {% endfor %};
    return 302 https://$host$request_uri;    
}
